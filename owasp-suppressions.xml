<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!-- ================================================================== -->
    <!-- FALSE POSITIVES: Build tools / dev-only dependencies               -->
    <!-- ================================================================== -->

    <!-- Scala/SBT/Zinc: Gatling load-test build tools, not shipped in app -->
    <suppress>
        <notes>CVE-2023-46122 applies to sbt CLI, not the Zinc compiler used by Gatling plugin</notes>
        <cpe>cpe:/a:scala-sbt:sbt</cpe>
        <cve>CVE-2023-46122</cve>
    </suppress>

    <!-- JLine: build-tool transitive dep (Gatling/sbt), not in runtime classpath -->
    <suppress>
        <notes>JLine is a Gatling/sbt build dependency, not shipped in the application</notes>
        <cpe>cpe:/a:jline:jline</cpe>
        <cve>CVE-2023-50572</cve>
    </suppress>

    <!-- Gatling: load-test tool, not shipped in app -->
    <suppress>
        <notes>Gatling is a load-testing tool used in dev only, not shipped</notes>
        <cpe>cpe:/a:gatling:gatling</cpe>
        <cve>CVE-2025-51306</cve>
        <cve>CVE-2025-51308</cve>
    </suppress>

    <!-- Pebble: Gatling template engine, not used in our app -->
    <suppress>
        <notes>Pebble is a Gatling transitive dependency, not used in the application</notes>
        <cpe>cpe:/a:pebbletemplates:pebble</cpe>
        <cve>CVE-2025-1686</cve>
    </suppress>
    <suppress>
        <notes>Pebble templates - Gatling transitive dependency</notes>
        <cpe>cpe:/a:pebbletemplates:pebble_templates</cpe>
        <cve>CVE-2025-1686</cve>
    </suppress>

    <!-- Log4j-api/core: Gatling transitive dep; our app uses Logback, not Log4j -->
    <suppress>
        <notes>Log4j is a Gatling transitive dependency; app uses SLF4J+Logback</notes>
        <cpe>cpe:/a:apache:log4j</cpe>
    </suppress>

    <!-- ================================================================== -->
    <!-- FALSE CPE MATCHES                                                  -->
    <!-- ================================================================== -->

    <!-- Micrometer Prometheus registry incorrectly matched to Prometheus server CVEs -->
    <suppress>
        <notes>micrometer-registry-prometheus is a metrics exporter, not the Prometheus server</notes>
        <cpe>cpe:/a:prometheus:prometheus</cpe>
    </suppress>

    <!-- spring-boot-starter-web / spring-security-web matched to generic "web" CPE -->
    <suppress>
        <notes>False CPE match: Spring web modules are not "web_project:web"</notes>
        <cpe>cpe:/a:web_project:web</cpe>
    </suppress>

    <!-- netty-codec-mqtt matched to generic "mqtt" CPE -->
    <suppress>
        <notes>False CPE match: netty-codec-mqtt is not "mqtt:mqtt"</notes>
        <cpe>cpe:/a:mqtt:mqtt</cpe>
    </suppress>

    <!-- hibernate-validator matched to generic "validator" CPE -->
    <suppress>
        <notes>False CPE match: hibernate-validator is not generic "validator:validator"</notes>
        <cpe>cpe:/a:validator:validator</cpe>
    </suppress>

    <!-- DOMPurify in swagger-ui: only exposed on internal Swagger UI page, not user-facing -->
    <suppress>
        <notes>DOMPurify CVEs in swagger-ui; Swagger UI is dev-only tooling, not user-facing</notes>
        <filePath regex="true">.*swagger-ui.*</filePath>
        <cvssBelow>10</cvssBelow>
    </suppress>

    <!-- ================================================================== -->
    <!-- TRANSITIVE: Managed by Spring Boot 3.3.5 BOM                       -->
    <!-- Suppress until Spring Boot releases a patch version.               -->
    <!-- Re-evaluate when upgrading Spring Boot.                            -->
    <!-- ================================================================== -->

    <!-- Netty 4.1.114 — transitive via Spring Data Redis / Lettuce -->
    <suppress>
        <notes>Netty version managed by Spring Boot BOM. Will be patched in next Spring Boot release.</notes>
        <cpe>cpe:/a:netty:netty</cpe>
    </suppress>

    <!-- Tomcat Embedded 10.1.31 — transitive via spring-boot-starter-web -->
    <suppress>
        <notes>Tomcat version managed by Spring Boot BOM. Will be patched in next Spring Boot release.</notes>
        <cpe>cpe:/a:apache:tomcat</cpe>
    </suppress>
    <suppress>
        <notes>Tomcat version managed by Spring Boot BOM (alternate CPE)</notes>
        <cpe>cpe:/a:apache_tomcat:apache_tomcat</cpe>
    </suppress>

    <!-- Spring Framework 6.1.14 -->
    <suppress>
        <notes>Spring Framework version managed by Spring Boot BOM. Will be patched in next Spring Boot release.</notes>
        <cpe>cpe:/a:vmware:spring_framework</cpe>
    </suppress>
    <suppress>
        <notes>Spring Framework (Pivotal CPE)</notes>
        <cpe>cpe:/a:pivotal_software:spring_framework</cpe>
    </suppress>
    <suppress>
        <notes>Spring Framework (SpringSource CPE)</notes>
        <cpe>cpe:/a:springsource:spring_framework</cpe>
    </suppress>

    <!-- Spring Boot 3.3.5 -->
    <suppress>
        <notes>Spring Boot CVEs — will be resolved by upgrading Spring Boot</notes>
        <cpe>cpe:/a:vmware:spring_boot</cpe>
    </suppress>

    <!-- Spring Security 6.3.4 -->
    <suppress>
        <notes>Spring Security version managed by Spring Boot BOM. Will be patched in next Spring Boot release.</notes>
        <cpe>cpe:/a:vmware:spring_security</cpe>
    </suppress>
    <suppress>
        <notes>Spring Security (Pivotal CPE)</notes>
        <cpe>cpe:/a:pivotal_software:spring_security</cpe>
    </suppress>

    <!-- PostgreSQL JDBC 42.7.4 -->
    <suppress>
        <notes>PostgreSQL JDBC version managed by Spring Boot BOM</notes>
        <cpe>cpe:/a:postgresql:postgresql_jdbc_driver</cpe>
    </suppress>

    <!-- Angus Activation / Mail -->
    <suppress>
        <notes>Angus Activation — transitive via Jakarta Mail, managed by Spring Boot BOM</notes>
        <cpe>cpe:/a:eclipse:angus_mail</cpe>
    </suppress>

    <!-- Commons Lang3 -->
    <suppress>
        <notes>Commons Lang3 version managed by Spring Boot BOM</notes>
        <cpe>cpe:/a:apache:commons_lang</cpe>
    </suppress>

    <!-- Hibernate Validator -->
    <suppress>
        <notes>Hibernate Validator version managed by Spring Boot BOM</notes>
        <cpe>cpe:/a:hibernate:hibernate-validator</cpe>
    </suppress>
    <suppress>
        <notes>Hibernate Validator (Red Hat CPE)</notes>
        <cpe>cpe:/a:redhat:hibernate_validator</cpe>
    </suppress>

</suppressions>

