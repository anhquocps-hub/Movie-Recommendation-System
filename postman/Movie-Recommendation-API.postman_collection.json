          "name": "List Movies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/movies?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "movies"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "genre", "value": "action", "disabled": true },
                { "key": "year", "value": "2010", "disabled": true },
                { "key": "minRating", "value": "4.0", "disabled": true }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns paginated content', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.content).to.be.an('array');",
                  "  pm.expect(json.data.totalElements).to.be.a('number');",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.data.content.length > 0) {",
